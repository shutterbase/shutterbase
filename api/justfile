# Shutterbase API test/dev recipes. Run from the api/ directory.
# Tiers per REWRITE-SPEC "Test harness": unit (no containers), e2e (testcontainers),
# ui (Playwright — lands with the frontend story).

# default: list recipes
default:
    @just --list

# Unit tier: no containers. ent enttest+SQLite + mocked S3/inference where relevant.
test-unit:
    go test ./...

# API e2e tier: testcontainers psql + rustfs (minio fallback). Requires Docker.
test-e2e:
    go test -tags e2e -count=1 -timeout 600s ./test/e2e/...

# Full Go test run: unit + e2e.
test: test-unit test-e2e

# UI e2e tier (Playwright). Placeholder — lands with the frontend story (S13/S14).
test-ui:
    @echo "test-ui: Playwright UI e2e arrives with the frontend story (cmd/testserver is ready)."

# go build sanity.
build:
    go build ./...

# Seed the configured Postgres with the time-relative fixtures (dev quick-action).
seed:
    go run ./cmd/seed

# Run the server with live reload (air, config in .air.toml). Needs `just up` from the repo root first.
air:
    air

# --- public gallery (cmd/gallery) ---

# Regenerate templ components (internal/gallery/web/*.templ -> *_templ.go).
gallery-templ:
    templ generate -path internal/gallery/web

# Rebuild the gallery stylesheet (bun + tailwind, tooling in internal/gallery/web/css).
gallery-css:
    cd internal/gallery/web/css && bun install --frozen-lockfile && bun run build

# Run the gallery with live reload against the local shutterbase stack (`just up` first).
# GALLERY_KEY selects the gallery row; create one in the SPA under /galleries.
gallery-air:
    GALLERY_KEY=${GALLERY_KEY:-dev} DEV=true air -c .air.gallery.toml

# Build the gallery binary.
gallery-build: gallery-templ
    go build -o ./tmp/gallery ./cmd/gallery
